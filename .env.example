# Salin berkas ini menjadi .env lalu isi nilainya.
# Semua variabel bersifat OPSIONAL: tanpa diisi, game tetap berjalan penuh
# (asisten fisika & akun pemain otomatis nonaktif).

# ---- Server ----
# Port HTTP/WebSocket server game. Bawaan 8787.
PORT=8787

# ---- Client desktop Electron ----
# URL WebSocket yang diberikan ke client Electron.
LOGICODIX_SERVER_URL=wss://hackathon-tong-sampah.onrender.com
# URL HTTP tempat Electron memuat aset client.
LOGICODIX_CLIENT_URL=http://127.0.0.1:8787
# Set 1 untuk membuka jendela berukuran ponsel (npm run phone).
LOGICODIX_PHONE=

# ---- Asisten Fisika (chatbot AI, lewat gateway Helipod) ----
# Kunci gateway Helipod. Bila kosong, server mencoba berkas ~/.helipod_key.
HELIPOD_API_KEY=
# Model yang dipakai. Bawaan qwen-vl-ocr.
HELIPOD_MODEL=qwen-vl-ocr
# Base URL gateway Helipod. Bawaan https://ai.helipod.io/v1.
HELIPOD_BASE_URL=https://ai.helipod.io/v1

# ---- Akun pemain (Supabase, opsional) ----
# Project URL Supabase, mis. https://xxxx.supabase.co.
SUPABASE_URL=
# Anon key Supabase (aman di sisi klien).
SUPABASE_ANON_KEY=
# Jalur cadangan hapus/ekspor di server. Tidak wajib.
SUPABASE_SERVICE_ROLE_KEY=
# Hanya bila proyek memakai penandatanganan HS256.
SUPABASE_JWT_SECRET=

# ---- Build APK (dipakai GitHub Actions, bukan server) ----
# Alamat server bawaan yang ditanam ke APK saat build.
LOGICODIX_DEFAULT_SERVER=https://hackathon-tong-sampah.onrender.com
